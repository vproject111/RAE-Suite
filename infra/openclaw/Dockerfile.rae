FROM node:22-bookworm-slim AS builder
WORKDIR /app
ENV CI=true
RUN apt-get update && apt-get install -y git && npm install -g pnpm && rm -rf /var/lib/apt/lists/*
COPY . .
RUN pnpm install --ignore-scripts
RUN OPENCLAW_A2UI_SKIP_MISSING=1 pnpm build
RUN pnpm ui:build
RUN pnpm prune --prod && \
    rm -rf /app/node_modules/.pnpm/@node-llama-cpp+linux-x64-cuda* \
           /app/node_modules/.pnpm/@node-llama-cpp+linux-x64-vulkan* \
           /app/node_modules/.pnpm/*-musl* \
           /root/.local/share/pnpm/store /root/.npm /root/.cache

FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production
RUN chown -R node:node /app
COPY --from=builder --chown=node:node /app /app
USER node
CMD ["node", "openclaw.mjs", "gateway", "--bind", "lan", "--port", "18789", "--allow-unconfigured"]
